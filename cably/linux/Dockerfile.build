# Build + test image for Cably Desktop on Linux (Ubuntu 24.04, any arch).
#
#   docker build -t cably-desktop-linux-build:ubuntu24.04 -f cably/linux/Dockerfile.build cably/linux
#
# The fork is NOT copied in: mount it read-only at /src, a named volume at /build (the
# Ninja tree, incremental across containers), another at /opt/cably-desktop (the install
# prefix the tests use) and the D1 fixtures at /fixtures.  See cably/linux/README.md.
#
# Package list: derived from KiCad 10's top-level find_package() calls (the Debian
# packaging control file needs a GitLab login to fetch) plus what the Cably additions and
# the test scripts need: libsecret (future Linux secret store), clang (the unit tests are
# built standalone with clang++ like on macOS), xvfb/xauth (launch test), python3/curl/lsof
# (bridge.sh's mock cloud + loopback checks), file/dpkg-dev (packaging), desktop-file-utils
# (identity-linux.sh validates the installed .desktop entries), libspnav (REQUIRED by KiCad).
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    # toolchain
    build-essential clang cmake ninja-build pkg-config git ca-certificates \
    gettext swig python3 python3-dev \
    # wxWidgets (GTK3) incl. the gl + webview components KiCad's find_package asks for
    libwxgtk3.2-dev libwxgtk-webview3.2-dev libgtk-3-dev \
    # graphics / text
    libglew-dev libglm-dev libgl1-mesa-dev libglu1-mesa-dev libegl1-mesa-dev \
    libcairo2-dev libpixman-1-dev libfreetype-dev libfontconfig-dev libharfbuzz-dev \
    libx11-dev libwayland-dev \
    # data / net / misc libraries
    libboost-dev libboost-locale-dev libboost-filesystem-dev libboost-system-dev \
    libcurl4-openssl-dev libssl-dev libzstd-dev zlib1g-dev libbz2-dev \
    libgit2-dev unixodbc-dev libsecret-1-dev libspnav-dev libpoppler-glib-dev \
    # ngspice, IPC API (nng + protobuf), STEP/3D (OCCT 7.6)
    libngspice0-dev libnng-dev libprotobuf-dev protobuf-compiler \
    libocct-data-exchange-dev libocct-foundation-dev libocct-modeling-algorithms-dev \
    libocct-modeling-data-dev libocct-ocaf-dev libocct-visualization-dev \
    # tests + packaging
    xvfb xauth curl lsof file dpkg-dev procps desktop-file-utils \
    && rm -rf /var/lib/apt/lists/*

# A non-root build user.  ubuntu:24.04 already ships uid 1000 as "ubuntu"; the build
# user gets its own uid so the named volumes are unambiguous.
RUN useradd --create-home --uid 1001 --shell /bin/bash builder \
    && mkdir -p /build /opt/cably-desktop /src /fixtures \
    && chown builder:builder /build /opt/cably-desktop
# The bind-mounted fork belongs to another uid: git (cmake/KiCadVersion.cmake runs
# `git describe`) must not refuse it as "dubious ownership".
USER builder
RUN git config --global --add safe.directory '*'
WORKDIR /build
