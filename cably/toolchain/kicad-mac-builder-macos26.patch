+# -DCABLY_DMG_TEMPLATE=/path/to/other.dmg.tar.bz2 (empty string = KiCad's template).
+set(CABLY_DMG_TEMPLATE "${PACKAGE_KICAD_SOURCE_DIR}/cably/toolchain/dmg/cablytemplate.dmg.tar.bz2"
+    CACHE FILEPATH "Tarball holding the DMG template image (<name>.dmg) package.sh starts from")
