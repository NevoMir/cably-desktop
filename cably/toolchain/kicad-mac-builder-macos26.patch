 ExternalProject_Add(
     package-kicad-unified
-    DEPENDS kicad symbols docs footprints templates packages3d
+    # Cably F6-lite: no 3D models (multi-GB, packaged separately later) and no docs in the dev DMG.
+    DEPENDS kicad symbols footprints templates
     PREFIX package-kicad-unified
     DOWNLOAD_COMMAND ""
     UPDATE_COMMAND   ""
