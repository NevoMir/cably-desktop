+    COMMAND ./configure --prefix=${ngspice_INSTALL_DIR} --with-ngshared CXXFLAGS=-Wno-invalid-specialization CFLAGS=-Wno-invalid-specialization
         --enable-xspice --enable-cider --disable-debug --disable-openmp
