diff --git a/kicad-mac-builder/bin/package.sh b/kicad-mac-builder/bin/package.sh
index b059e7f..35f214e 100755
--- a/kicad-mac-builder/bin/package.sh
+++ b/kicad-mac-builder/bin/package.sh
@@ -40,7 +40,13 @@ setup_dmg()
     if [ -e "${TEMPLATE}" ]; then
         rm "${TEMPLATE}"
     fi
-    tar xf "${PACKAGING_DIR}"/"${TEMPLATE}".tar.bz2
+    # Cably F6: the product template lives in the fork (cably/toolchain/dmg/); when
+    # CABLY_DMG_TEMPLATE names its tarball, use it instead of KiCad's PACKAGING_DIR one.
+    if [ -n "${CABLY_DMG_TEMPLATE}" ]; then
+        tar xf "${CABLY_DMG_TEMPLATE}"
+    else
+        tar xf "${PACKAGING_DIR}"/"${TEMPLATE}".tar.bz2
+    fi
     if [ ! -e "${TEMPLATE}" ]; then
         echo "Unable to find ${TEMPLATE}"
         exit 1
@@ -49,9 +55,9 @@ setup_dmg()
     # resize the template, and mount it
 
     if ! hdiutil resize -sectors "${DMG_SIZE}" "${TEMPLATE}"; then
-        hdiutil resize -limits kicadtemplate.dmg # Debugging step, to see what the limits are.
+        hdiutil resize -limits "${TEMPLATE}" # Debugging step, to see what the limits are.
         hdiutil resize -sectors 10167525 "${TEMPLATE}"
-        hdiutil resize -limits kicadtemplate.dmg
+        hdiutil resize -limits "${TEMPLATE}"
         if ! hdiutil resize -sectors "${DMG_SIZE}" "${TEMPLATE}"; then
           echo "Cannot resize template dmg, exiting."
           exit 1
@@ -61,15 +67,26 @@ setup_dmg()
     DEVICE=$(hdiutil attach "${TEMPLATE}" -noautoopen -nobrowse -nomount | awk '/Apple_HFS/ {print $1}')
     mount -t hfs -o nobrowse "${DEVICE}" "${MOUNTPOINT}"
     mdutil -i off "${MOUNTPOINT}" || true
+    # Cably F6: MOUNT_NAME is the product's volume name (what Finder shows and
+    # where the bless step below expects it under /Volumes); enforce it on the
+    # template rather than trusting whatever it was created with.
+    if ! diskutil rename "${DEVICE}" "${MOUNT_NAME}"; then
+        echo "Cannot rename the template volume to ${MOUNT_NAME}, exiting."
+        exit 1
+    fi
 }
 
 
 fixup_and_cleanup()
 {
     # update background of the DMG
-    cp "${PACKAGING_DIR}"/background.png "${MOUNTPOINT}"/.
-    # Rehide the background file
-    SetFile -a V "${MOUNTPOINT}"/background.png
+    # Cably F6: our template already carries its own hidden .background.png (and the
+    # .DS_Store that references it); KiCad's background.png must not ride along.
+    if [ -z "${CABLY_DMG_TEMPLATE}" ]; then
+        cp "${PACKAGING_DIR}"/background.png "${MOUNTPOINT}"/.
+        # Rehide the background file
+        SetFile -a V "${MOUNTPOINT}"/background.png
+    fi
 
     # Retry up to 5 times, increasing wait each time
     DETACHED=0
@@ -165,6 +182,7 @@ echo "KICAD_SOURCE_DIR: ${KICAD_SOURCE_DIR}"
 echo "KICAD_INSTALL_DIR: ${KICAD_INSTALL_DIR}"
 echo "VERBOSE: ${VERBOSE}"
 echo "TEMPLATE: ${TEMPLATE}"
+echo "CABLY_DMG_TEMPLATE: ${CABLY_DMG_TEMPLATE}"
 echo "DMG_DIR: ${DMG_DIR}"
 echo "PACKAGE_TYPE: ${PACKAGE_TYPE}"
 if [ -n "${RELEASE_NAME}" ]; then # if RELEASE_NAME is unset, or is set to empty string
@@ -189,6 +207,16 @@ if [ -z "${TEMPLATE}" ]; then
     exit 1
 fi
 
+if [ -n "${CABLY_DMG_TEMPLATE}" ]; then
+    if [ ! -f "${CABLY_DMG_TEMPLATE}" ]; then
+        echo "CABLY_DMG_TEMPLATE is set but ${CABLY_DMG_TEMPLATE} does not exist."
+        exit 1
+    fi
+    # the tarball holds <name>.dmg; TEMPLATE is that name (cablytemplate.dmg)
+    TEMPLATE="$(basename "${CABLY_DMG_TEMPLATE}" .tar.bz2)"
+    echo "TEMPLATE (from CABLY_DMG_TEMPLATE): ${TEMPLATE}"
+fi
+
 if [ -z "${DMG_DIR}" ]; then
     echo "DMG_DIR must be set."
     exit 1
@@ -233,12 +261,20 @@ case "${PACKAGE_TYPE}" in
     ;;
     unified)
         KICAD_GIT_REV=$(cd "${KICAD_SOURCE_DIR}" && git rev-parse --short HEAD)
-        MOUNT_NAME='KiCad'
+        # Cably F6: the DMG presents the product name only; the upstream mark stays attribution.
+        # Version = KICAD_SEMANTIC_VERSION of the built app (CFBundleShortVersionString
+        # up to the first "-", i.e. the tag CMake's KiCadVersion.cmake derived it from).
+        MOUNT_NAME='Cably Desktop'
+        PRODUCT_DIR='Cably Desktop'
         DMG_SIZE=15567525
+        KICAD_VERSION=$(/usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" "${KICAD_INSTALL_DIR}/KiCad.app/Contents/Info.plist" 2>/dev/null | sed 's/-.*//')
+        if [ -z "${KICAD_VERSION}" ]; then
+            KICAD_VERSION=$(cd "${KICAD_SOURCE_DIR}" && git describe --tags --abbrev=0 2>/dev/null || echo unknown)
+        fi
         if [ -z "$RELEASE_NAME" ]; then
-            DMG_NAME=kicad-unified-"${NOW}"-"${KICAD_GIT_REV}".dmg
+            DMG_NAME=cably-desktop-"${KICAD_VERSION}"-"${NOW}"-"${KICAD_GIT_REV}".dmg
         else
-            DMG_NAME=kicad-unified-"${RELEASE_NAME}".dmg
+            DMG_NAME=cably-desktop-"${RELEASE_NAME}".dmg
         fi
     ;;
     *)
@@ -258,10 +294,35 @@ case "${PACKAGE_TYPE}" in
       exit 1
     ;;
     unified)
-        mkdir -p "${MOUNTPOINT}"/KiCad
-        rsync -al "${KICAD_INSTALL_DIR}"/* "${MOUNTPOINT}"/KiCad/. # IMPORTANT: must preserve symlinks
-        echo "Moving demos"
-        mv "${MOUNTPOINT}"/KiCad/demos "${MOUNTPOINT}"/
+        # Cably F6 (2026-09-05): the REAL bundle goes to the top level under the
+        # product name (the toolchain hard-codes KiCad.app during build/install;
+        # the rename happens only here), the six editor launcher symlinks are
+        # re-pointed at it inside the product folder, and demos go there too.
+        # Nothing in the image may be named KiCad.app.
+        rsync -al "${KICAD_INSTALL_DIR}/KiCad.app/" "${MOUNTPOINT}/${PRODUCT_DIR}.app/" # IMPORTANT: must preserve symlinks
+        mkdir -p "${MOUNTPOINT}/${PRODUCT_DIR}"
+        for l in "${KICAD_INSTALL_DIR}"/*.app; do
+            [ -L "${l}" ] || continue
+            name="$(basename "${l}")"
+            target="$(readlink "${l}")"
+            case "${name}" in "${PRODUCT_DIR}.app") continue ;; esac   # the build tree's symlink to KiCad.app
+            case "${target}" in
+                KiCad.app/Contents/Applications/*.app)
+                    ln -s "../${PRODUCT_DIR}.app/${target#KiCad.app/}" "${MOUNTPOINT}/${PRODUCT_DIR}/${name}"
+                ;;
+                *)
+                    echo "Unexpected launcher symlink ${name} -> ${target}"
+                    exit 1
+                ;;
+            esac
+        done
+        echo "Copying demos"
+        rsync -al "${KICAD_INSTALL_DIR}/demos/" "${MOUNTPOINT}/${PRODUCT_DIR}/demos/"
+        if find "${MOUNTPOINT}" -iname '*kicad.app*' | grep -q .; then
+            echo "Something in the image is still named KiCad.app:"
+            find "${MOUNTPOINT}" -iname '*kicad.app*'
+            exit 1
+        fi
     ;;
     *)
         echo "PACKAGE_TYPE must be \"unified\"."
