     UPDATE_COMMAND      ""
     PATCH_COMMAND       ""
     CONFIGURE_COMMAND ./autogen.sh
-    COMMAND ./configure --prefix=${ngspice_INSTALL_DIR} --with-ngshared
+    # Cably F1: Xcode 26 / Apple clang 21 hard-errors on ngspice's cppduals
